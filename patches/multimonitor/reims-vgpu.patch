+#!/usr/bin/env python3
+"""Route reims pointer protocol v1 to identified macOS guest displays.
+
+Only READY is written to stdout. Input is trusted local transport, never a
+network listener. No permissions are requested or changed by this program.
+"""
+import argparse
+import ctypes
+import dataclasses
+import math
+import os
+import selectors
+import signal
+import sys
+import time
+
+
+@dataclasses.dataclass(frozen=True)
+class Display:
+    identifier: int
+    vendor: int
+    serial: int
+    x: float
+    y: float
+    width: float
+    height: float
+    mirrored: bool = False
+
+
+@dataclasses.dataclass(frozen=True)
+class Relative:
+    head: int
+    dx: int
+    dy: int
+    buttons: int
+    wheel_x: int
+    wheel_y: int
+
+
+def parse_packet(line, heads):
+    """Strict, bounded ASCII framing; returns None for a release/reset."""
+    if not line.endswith(b"\n") or len(line) > 160:
+        raise ValueError("invalid packet framing")
+    try:
+        words = line.decode("ascii").split()
+    except UnicodeDecodeError as error:
+        raise ValueError("packet is not ASCII") from error
+    if words == ["R", "1"]:
+        return None
+    if len(words) != 8 or words[0] not in ("P", "M") or words[1] != "1":
+        raise ValueError("unknown protocol or packet")
+    # Reject Python int syntax outside the signed decimal wire format.
+    for value in words[2:]:
+        digits = value[1:] if value.startswith("-") else value
+        if not digits or not all("0" <= c <= "9" for c in digits):
+            raise ValueError("invalid decimal field")
+    head, x, y, buttons, wheel_x, wheel_y = map(int, words[2:])
+    if not 0 <= head < heads:
+        raise ValueError("head out of range")
+    minimum = -32767 if words[0] == "M" else 0
+    if not (minimum <= x <= 32767 and minimum <= y <= 32767 and 0 <= buttons <= 31):
+        raise ValueError("coordinates or buttons out of range")
+    if not (-32767 <= wheel_x <= 32767 and -32767 <= wheel_y <= 32767):
+        raise ValueError("wheel out of range")
+    if words[0] == "M":
+        return Relative(head, x, y, buttons, wheel_x, wheel_y)
+    return head, x, y, buttons, wheel_x, wheel_y
+
+
+def display_map(displays, heads, vendor, serial_base):
+    """Match explicit EDID identities, never enumeration order or display ID."""
+    result = {}
+    for head in range(heads):
+        matches = [d for d in displays if d.vendor == vendor and d.serial == serial_base + head]
+        if len(matches) != 1:
+            raise ValueError("head %d display identity unavailable or ambiguous" % head)
+        d = matches[0]
+        if d.mirrored or not all(math.isfinite(v) for v in (d.x, d.y, d.width, d.height)):
+            raise ValueError("head %d has unusable display bounds" % head)
+        if d.width < 1 or d.height < 1:
+            raise ValueError("head %d has empty display bounds" % head)
+        result[head] = d
+    if len({d.identifier for d in result.values()}) != heads:
+        raise ValueError("heads resolve to the same display")
+    return result
+
+
+def position(display, x, y):
+    # CGDisplayBounds is in global desktop coordinates, including negative
+    # origins. Do not use backing pixel dimensions: those differ with HiDPI.
+    # Keep the inclusive normalized endpoint inside this display's rectangle.
+    return (display.x + x * (display.width - 1) / 32767,
+            display.y + y * (display.height - 1) / 32767)
+
+
+def relative_position(displays, point, dx, dy):
+    """Sweep through adjoining display rectangles; stop at gaps and slide at edges.
+
+    Closed geometric edges are used for the sweep, so adjacent displays meet
+    without a one-pixel gap. The final cursor is clamped inside a real display.
+    """
+    rectangles = list(displays.items())
+
+    def sweep(start, delta):
+        intervals = []
+        for _, d in rectangles:
+            lo, hi = 0.0, 1.0
+            for origin, movement, low, high in (
+                    (start[0], delta[0], d.x, d.x + d.width),
+                    (start[1], delta[1], d.y, d.y + d.height)):
+                if movement == 0:
+                    if not low <= origin <= high:
+                        hi = -1
+                        break
+                else:
+                    a, b = sorted(((low - origin) / movement, (high - origin) / movement))
+                    lo, hi = max(lo, a), min(hi, b)
+            if lo <= hi:
+                intervals.append((lo, hi))
+        end = 0.0
+        for lo, hi in sorted(intervals):
+            if lo > end + 1e-9:
+                break
+            end = max(end, hi)
+        return (start[0] + delta[0] * end, start[1] + delta[1] * end), end
+
+    reached, fraction = sweep(point, (dx, dy))
+    if fraction < 1:
+        # Keep the traversable component of diagonal motion along a wall.
+        candidates = [sweep(reached, (dx * (1 - fraction), 0))[0],
+                      sweep(reached, (0, dy * (1 - fraction)))[0]]
+        reached = max(candidates, key=lambda p: math.dist(p, reached))
+    candidates = [(head, (min(max(reached[0], d.x), d.x + d.width - 1),
+                          min(max(reached[1], d.y), d.y + d.height - 1)))
+                  for head, d in rectangles]
+    return min(candidates, key=lambda item: math.dist(item[1], reached))
+
+
+class Pointer:
+    def __init__(self, backend, heads=2, vendor=4102, serial_base=1, clock=time.monotonic):
+        self.backend = backend
+        self.heads = heads
+        self.vendor = vendor
+        self.serial_base = serial_base
+        self.clock = clock
+        self.buttons = 0
+        self.point = (0.0, 0.0)
+        self.head = None
+        self.clicks = {}
+        self.active_clicks = {}
+
+    def mapping(self):
+        return display_map(self.backend.displays(), self.heads, self.vendor, self.serial_base)
+
+    def reset(self):
+        """Release at last valid location even if a display has disappeared."""
+        failure = None
+        try:
+            native_buttons = self.backend.held_buttons() & 31
+            if native_buttons and not self.buttons:
+                # A previous helper may have died after posting a mouse-down.
+                # Recover at the current cursor, never this instance's (0, 0).
+                self.point = self.backend.pointer_position()
+            self.buttons |= native_buttons
+        except (RuntimeError, OSError) as error:
+            # Still attempt releases for this instance's tracked buttons.
+            failure = error
+        for button in range(5):
+            if self.buttons & (1 << button):
+                try:
+                    self.backend.mouse("up", button, self.point, self.active_clicks.get(button, 1))
+                except (RuntimeError, OSError) as error:
+                    failure = failure or error
+                finally:
+                    self.buttons &= ~(1 << button)
+        self.clicks.clear()
+        self.active_clicks.clear()
+        self.head = None
+        if failure:
+            raise failure
+
+    def accept(self, packet):
+        if packet is None:
+            self.reset()
+            return
+        mapping = self.mapping()
+        if isinstance(packet, Relative):
+            if self.head is None:
+                self.point = self.backend.pointer_position()
+            head, point = relative_position(mapping, self.point, packet.dx, packet.dy)
+            buttons, wheel_x, wheel_y = packet.buttons, packet.wheel_x, packet.wheel_y
+        else:
+            head, x, y, buttons, wheel_x, wheel_y = packet
+            point = position(mapping[head], x, y)
+        # Move with the OLD button state so a final release packet also moves
+        # the dragged object to its destination before releasing it.
+        held = next((button for button in range(5) if self.buttons & (1 << button)), None)
+        self.backend.mouse("move" if held is None else "drag", held or 0, point, 0)
+        self.point = point
+        for button in range(5):
+            previous = self.clicks.get(button)
+            if self.buttons & (1 << button) and previous:
+                _, last_head, last_point, _ = previous
+                if head != last_head or math.hypot(point[0] - last_point[0], point[1] - last_point[1]) > 4:
+                    # A drag is not the first half of a double-click, even if
+                    # the pointer returns to its original location.
+                    self.clicks.pop(button)
+        now = self.clock()
+        for button in range(5):
+            mask = 1 << button
+            if self.buttons & mask and not buttons & mask:
+                self.backend.mouse("up", button, point, self.active_clicks.pop(button, 1))
+                self.buttons &= ~mask
+            elif buttons & mask and not self.buttons & mask:
+                previous = self.clicks.get(button)
+                count = 1
+                if previous:
+                    when, last_head, last_point, last_count = previous
+                    distance = math.hypot(point[0] - last_point[0], point[1] - last_point[1])
+                    if head == last_head and now - when <= self.backend.double_click_interval and distance <= 4:
+                        count = last_count + 1
+                self.clicks[button] = (now, head, point, count)
+                self.active_clicks[button] = count
+                # Track before posting so a backend failure still triggers a
+                # conservative release during teardown.
+                self.buttons |= mask
+                self.backend.mouse("down", button, point, count)
+        self.head = head
+        if wheel_x or wheel_y:
+            self.backend.scroll(point, wheel_x, wheel_y)
+
+
+def layout_packet(mapping):
+    fields = ["L", "1", str(len(mapping))]
+    for head, d in sorted(mapping.items()):
+        fields.extend(map(str, (head, d.x, d.y, d.width, d.height)))
+    return " ".join(fields) + "\n"
+
+
+def layout_lines(stream, output, pointer):
+    """Report layout changes even while idle; bound frames without buffered-read stalls."""
+    previous = None
+    pending = bytearray()
+    with selectors.DefaultSelector() as selector:
+        selector.register(stream, selectors.EVENT_READ)
+        while True:
+            current = layout_packet(pointer.mapping())
+            if current != previous:
+                output.write(current)
+                output.flush()
+                previous = current
+            if not selector.select(.25):
+                continue
+            chunk = os.read(stream.fileno(), 4096)
+            if not chunk:
+                if pending:
+                    raise ValueError("truncated input packet")
+                return
+            pending.extend(chunk)
+            while b"\n" in pending:
+                line, _, rest = pending.partition(b"\n")
+                pending = bytearray(rest)
+                yield bytes(line) + b"\n"
+            if len(pending) > 160:
+                raise ValueError("oversized input packet")
+
+
+def serve(stream, output, pointer, report_layout=False):
+    """One transport session. Malformed input is fatal, with held keys released."""
+    try:
+        pointer.mapping()
+        pointer.reset()
+        output.write("READY 1\n")
+        output.flush()
+        lines = layout_lines(stream, output, pointer) if report_layout else iter(lambda: stream.readline(161), b"")
+        for line in lines:
+            pointer.accept(parse_packet(line, pointer.heads))
+    finally:
+        pointer.reset()
+
+
+class CGPoint(ctypes.Structure):
+    _fields_ = [("x", ctypes.c_double), ("y", ctypes.c_double)]
+
+
+class CGSize(ctypes.Structure):
+    _fields_ = [("width", ctypes.c_double), ("height", ctypes.c_double)]
+
+
+class CGRect(ctypes.Structure):
+    _fields_ = [("origin", CGPoint), ("size", CGSize)]
+
+
+class MacBackend:
+    def __init__(self):
+        if sys.platform != "darwin":
+            raise RuntimeError("native pointer injection requires macOS")
+        self.cg = ctypes.CDLL("/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics")
+        self.cf = ctypes.CDLL("/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation")
+        ax = ctypes.CDLL("/System/Library/Frameworks/ApplicationServices.framework/ApplicationServices")
+        ax.AXIsProcessTrusted.restype = ctypes.c_bool
+        ax.AXIsProcessTrusted.argtypes = []
+        if not ax.AXIsProcessTrusted():
+            raise RuntimeError("Accessibility trust is required; no permission changes were made")
+        self._bind("CGGetActiveDisplayList", ctypes.c_int32,
+                   [ctypes.c_uint32, ctypes.POINTER(ctypes.c_uint32), ctypes.POINTER(ctypes.c_uint32)])
+        for name in ("CGDisplayVendorNumber", "CGDisplaySerialNumber", "CGDisplayMirrorsDisplay"):
+            self._bind(name, ctypes.c_uint32, [ctypes.c_uint32])
+        self._bind("CGDisplayBounds", CGRect, [ctypes.c_uint32])
+        self._bind("CGEventCreate", ctypes.c_void_p, [ctypes.c_void_p])
+        self._bind("CGEventGetLocation", CGPoint, [ctypes.c_void_p])
+        self._bind("CGEventCreateMouseEvent", ctypes.c_void_p,
+                   [ctypes.c_void_p, ctypes.c_uint32, CGPoint, ctypes.c_uint32])
+        self._bind("CGEventSourceFlagsState", ctypes.c_uint64, [ctypes.c_int32])
+        self._bind("CGEventSourceButtonState", ctypes.c_bool, [ctypes.c_int32, ctypes.c_uint32])
+        self._bind("CGEventSetFlags", None, [ctypes.c_void_p, ctypes.c_uint64])
+        self._bind("CGEventSetIntegerValueField", None, [ctypes.c_void_p, ctypes.c_uint32, ctypes.c_int64])
+        self._bind("CGEventSetLocation", None, [ctypes.c_void_p, CGPoint])
+        self._bind("CGEventPost", None, [ctypes.c_uint32, ctypes.c_void_p])
+        # Fixed-argument API avoids a variadic ctypes ABI across Intel/arm64.
+        self._bind("CGEventCreateScrollWheelEvent2", ctypes.c_void_p,
+                   [ctypes.c_void_p, ctypes.c_uint32, ctypes.c_uint32,
+                    ctypes.c_int32, ctypes.c_int32, ctypes.c_int32])
+        self.cf.CFRelease.restype = None
+        self.cf.CFRelease.argtypes = [ctypes.c_void_p]
+        self.last_point = self.pointer_position()
+        ctypes.CDLL("/System/Library/Frameworks/AppKit.framework/AppKit")
+        objc = ctypes.CDLL("/usr/lib/libobjc.A.dylib")
+        objc.objc_getClass.restype = ctypes.c_void_p
+        objc.objc_getClass.argtypes = [ctypes.c_char_p]
+        objc.sel_registerName.restype = ctypes.c_void_p
+        objc.sel_registerName.argtypes = [ctypes.c_char_p]
+        # double is returned in an SSE register on x86_64 (not fpret).
+        call = ctypes.CFUNCTYPE(ctypes.c_double, ctypes.c_void_p, ctypes.c_void_p)(("objc_msgSend", objc))
+        self.double_click_interval = call(objc.objc_getClass(b"NSEvent"), objc.sel_registerName(b"doubleClickInterval"))
+
+    def held_buttons(self):
+        return sum(1 << button for button in range(5)
+                   if self.cg.CGEventSourceButtonState(0, button))
+
+    def pointer_position(self):
+        event = self.cg.CGEventCreate(None)
+        if not event:
+            raise RuntimeError("cannot read current pointer location")
+        try:
+            point = self.cg.CGEventGetLocation(event)
+            return point.x, point.y
+        finally:
+            self.cf.CFRelease(event)
+
+    def _bind(self, name, result, arguments):
+        function = getattr(self.cg, name)
+        function.restype = result
+        function.argtypes = arguments
+
+    def displays(self):
+        ids = (ctypes.c_uint32 * 64)()
+        count = ctypes.c_uint32()
+        if self.cg.CGGetActiveDisplayList(64, ids, ctypes.byref(count)) or count.value >= 64:
+            raise RuntimeError("cannot enumerate active displays")
+        result = []
+        for identifier in ids[:count.value]:
+            bounds = self.cg.CGDisplayBounds(identifier)
+            result.append(Display(identifier, self.cg.CGDisplayVendorNumber(identifier),
+                                  self.cg.CGDisplaySerialNumber(identifier), bounds.origin.x,
+                                  bounds.origin.y, bounds.size.width, bounds.size.height,
+                                  bool(self.cg.CGDisplayMirrorsDisplay(identifier))))
+        return result
+
+    def _post(self, event, point, clicks=None, delta=None):
+        if not event:
+            raise RuntimeError("CoreGraphics could not create an event")
+        try:
+            # Combined session flags preserve modifiers from the VM keyboard.
+            self.cg.CGEventSetFlags(event, self.cg.CGEventSourceFlagsState(0))
+            self.cg.CGEventSetLocation(event, CGPoint(*point))
+            if clicks is not None:
+                self.cg.CGEventSetIntegerValueField(event, 1, clicks)
+            if delta is not None:
+                self.cg.CGEventSetIntegerValueField(event, 4, round(delta[0]))
+                self.cg.CGEventSetIntegerValueField(event, 5, round(delta[1]))
+            self.cg.CGEventPost(0, event)  # kCGHIDEventTap
+        finally:
+            self.cf.CFRelease(event)
+
+    def mouse(self, action, button, point, clicks):
+        types = {"move": (5, 5, 5), "drag": (6, 7, 27),
+                 "down": (1, 3, 25), "up": (2, 4, 26)}
+        event_type = types[action][min(button, 2)]
+        event = self.cg.CGEventCreateMouseEvent(None, event_type, CGPoint(*point), button)
+        delta = (point[0] - self.last_point[0], point[1] - self.last_point[1]) if action in ("move", "drag") else (0, 0)
+        self._post(event, point, clicks, delta)
+        self.last_point = point
+
+    def scroll(self, point, wheel_x, wheel_y):
+        # kCGScrollEventUnitLine=1; axis1 vertical, axis2 horizontal.
+        event = self.cg.CGEventCreateScrollWheelEvent2(None, 1, 2, wheel_y, wheel_x, 0)
+        self._post(event, point)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--heads", type=int, default=2)
+    parser.add_argument("--vendor", type=int, default=4102)
+    parser.add_argument("--serial-base", type=int, default=1)
+    parser.add_argument("--report-layout", action="store_true")
+    args = parser.parse_args()
+    if not 1 <= args.heads <= 64 or args.serial_base < 1:
+        parser.error("heads must be 1..64 and serial base must be positive")
+    def interrupted(_number, _frame):
+        raise KeyboardInterrupt()
+    signal.signal(signal.SIGTERM, interrupted)
+    signal.signal(signal.SIGHUP, interrupted)
+    try:
+        pointer = Pointer(MacBackend(), args.heads, args.vendor, args.serial_base)
+        serve(sys.stdin.buffer, sys.stdout, pointer, args.report_layout)
+        return 0
+    except (ValueError, RuntimeError, OSError, KeyboardInterrupt) as error:
+        print("reims-pointer: %s" % (error or "interrupted"), file=sys.stderr)
+        return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/multimonitor/input_probe.swift b/scripts/multimonitor/input_probe.swift
new file mode 100644
index 0000000000000000000000000000000000000000..5c2c43c1557b603a4999caf9e48814c2fd71e964
--- /dev/null
+++ b/scripts/multimonitor/input_probe.swift
@@ -0,0 +1,88 @@
+// A disposable acceptance surface. Run in the test guest and terminate to close.
+// Writes actual AppKit events to /tmp/reims-input-events.jsonl; never injects input.
+import AppKit
+import CoreGraphics
+
+final class ProbeView: NSView {
+    var head: UInt32 = 0
+    var clicks = 0
+    var marker = NSPoint(x: 100, y: 100)
+    override var acceptsFirstResponder: Bool { true }
+    override func acceptsFirstMouse(for event: NSEvent?) -> Bool { true }
+    override func draw(_ dirtyRect: NSRect) {
+        (head == 0 ? NSColor.systemBlue : NSColor.systemPurple).setFill()
+        bounds.fill()
+        let text = "Reims pointer test — head \(head)\nClicks: \(clicks)\nClick, drag, and scroll here"
+        text.draw(at: NSPoint(x: 30, y: bounds.height - 130), withAttributes: [
+            .font: NSFont.systemFont(ofSize: 26), .foregroundColor: NSColor.white])
+        NSColor.white.setFill()
+        NSBezierPath(ovalIn: NSRect(x: marker.x - 12, y: marker.y - 12,
+                                  width: 24, height: 24)).fill()
+    }
+    func record(_ event: NSEvent, _ action: String) {
+        let point = event.cgEvent?.location ?? .zero
+        // AppKit raises an exception when type-specific properties are read
+        // from another event type (for example scrollingDeltaY on mouseDown).
+        let scrolling = event.type == .scrollWheel
+        let data: [String: Any] = ["head": head, "action": action,
+            "x": point.x, "y": point.y, "clickCount": scrolling ? 0 : event.clickCount,
+            "button": scrolling ? 0 : event.buttonNumber,
+            "wheelX": scrolling ? event.scrollingDeltaX : 0,
+            "wheelY": scrolling ? event.scrollingDeltaY : 0,
+            "modifiers": event.modifierFlags.rawValue]
+        if let json = try? JSONSerialization.data(withJSONObject: data),
+           let line = String(data: json, encoding: .utf8) { if let data = (line + "\n").data(using: .utf8) {
+                let file = URL(fileURLWithPath: "/tmp/reims-input-events.jsonl")
+                if !FileManager.default.fileExists(atPath: file.path) {
+                    FileManager.default.createFile(atPath: file.path, contents: nil)
+                }
+                if let handle = try? FileHandle(forWritingTo: file) {
+                    handle.seekToEndOfFile(); handle.write(data); handle.closeFile()
+                }
+            } }
+        marker = convert(event.locationInWindow, from: nil)
+        needsDisplay = true
+    }
+    override func mouseDown(with e: NSEvent) { clicks += 1; record(e, "down") }
+    override func mouseUp(with e: NSEvent) { record(e, "up") }
+    override func mouseDragged(with e: NSEvent) { record(e, "drag") }
+    override func rightMouseDown(with e: NSEvent) { record(e, "right-down") }
+    override func rightMouseUp(with e: NSEvent) { record(e, "right-up") }
+    override func otherMouseDown(with e: NSEvent) { record(e, "other-down") }
+    override func otherMouseUp(with e: NSEvent) { record(e, "other-up") }
+    override func scrollWheel(with e: NSEvent) { record(e, "scroll") }
+}
+
+final class ProbeDelegate: NSObject, NSApplicationDelegate {
+    var windows: [NSWindow] = []
+    func applicationDidFinishLaunching(_ notification: Notification) {
+        var diagnostics: [[String: Any]] = []
+        for screen in NSScreen.screens {
+            guard let id = screen.deviceDescription[NSDeviceDescriptionKey("NSScreenNumber")] as? NSNumber,
+                  CGDisplayVendorNumber(id.uint32Value) == 4102 else {
+                diagnostics.append(["description": String(describing: screen.deviceDescription)])
+                continue
+            }
+            diagnostics.append(["display": id.uint32Value, "vendor": CGDisplayVendorNumber(id.uint32Value)])
+            let frame = screen.visibleFrame.insetBy(dx: 30, dy: 35)
+            let window = NSWindow(contentRect: frame,
+                                  styleMask: [.titled, .closable, .resizable],
+                                  backing: .buffered, defer: false)
+            let view = ProbeView(frame: NSRect(origin: .zero, size: frame.size))
+            view.head = CGDisplaySerialNumber(id.uint32Value) - 1
+            window.title = "Reims pointer test — head \(view.head)"
+            window.contentView = view
+            window.makeKeyAndOrderFront(nil)
+            windows.append(window)
+        }
+        if let data = try? JSONSerialization.data(withJSONObject: ["windows": windows.count, "screens": diagnostics]) {
+            try? data.write(to: URL(fileURLWithPath: "/tmp/reims-input-ready.json"))
+        }
+        NSApp.activate(ignoringOtherApps: true)
+    }
+}
+let app = NSApplication.shared
+let delegate = ProbeDelegate()
+app.delegate = delegate
+app.setActivationPolicy(.regular)
+withExtendedLifetime(delegate) { app.run() }
diff --git a/scripts/multimonitor/relay.py b/scripts/multimonitor/relay.py
new file mode 100644
index 0000000000000000000000000000000000000000..33ca0a532951be3a187c8d69ebb32850fca4d261
--- /dev/null
+++ b/scripts/multimonitor/relay.py
@@ -0,0 +1,159 @@
+#!/usr/bin/env python3
+"""Relay one local QEMU pointer socket to an explicit macOS SSH companion.
+
+The SSH alias and guest helper path are supplied by the user. Nothing is
+installed and no permission settings are changed. Losing either endpoint
+closes the other, allowing the companion to release held buttons on EOF.
+"""
+import argparse
+import os
+import time
+import selectors
+import shlex
+import signal
+import socket
+import subprocess
+import sys
+
+
+def relay(path, host, helper, heads, serial_base, *, ready_timeout=30, stall_timeout=5, layout_socket=None):
+    args = ['/usr/bin/python3', helper, '--heads', str(heads), '--serial-base', str(serial_base)]
+    if layout_socket:
+        args.append('--report-layout')
+    command = shlex.join(args)
+    process = subprocess.Popen(
+        ['ssh', '-T', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10',
+         '-o', 'ServerAliveInterval=5', '-o', 'ServerAliveCountMax=2',
+         host, command], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+        bufsize=0)
+    connection = None
+    layout = None
+    try:
+        os.set_blocking(process.stdout.fileno(), False)
+        os.set_blocking(process.stdin.fileno(), False)
+        with selectors.DefaultSelector() as selector:
+            selector.register(process.stdout, selectors.EVENT_READ)
+            deadline = time.monotonic() + ready_timeout
+            greeting = bytearray()
+            while b"\n" not in greeting:
+                remaining = deadline - time.monotonic()
+                if remaining <= 0 or not selector.select(remaining):
+                    raise RuntimeError('guest companion did not become ready')
+                chunk = os.read(process.stdout.fileno(), 32)
+                if not chunk:
+                    raise RuntimeError('guest companion exited before readiness')
+                greeting.extend(chunk)
+                if len(greeting) > 32 and b"\n" not in greeting:
+                    raise RuntimeError('oversized companion greeting')
+            greeting, _, feedback = greeting.partition(b"\n")
+            greeting += b"\n"
+            if greeting != b'READY 1\n':
+                raise RuntimeError('guest companion refused startup: %r' % greeting)
+            if layout_socket:
+                layout = socket.socket(socket.AF_UNIX)
+                layout.settimeout(1)
+                layout.connect(layout_socket)
+            elif feedback:
+                raise RuntimeError('unexpected companion feedback')
+            feedback = bytearray(feedback)
+
+            def forward_layout():
+                while b"\n" in feedback:
+                    line, _, rest = feedback.partition(b"\n")
+                    del feedback[:len(line) + 1]
+                    if not layout or not line.startswith(b'L 1 ') or len(line) > 4096:
+                        raise RuntimeError('invalid companion layout feedback')
+                    layout.sendall(line + b"\n")
+                if len(feedback) > 4096:
+                    raise RuntimeError('oversized companion layout feedback')
+
+            forward_layout()
+            connection = socket.socket(socket.AF_UNIX)
+            connection.connect(path)
+            connection.sendall(greeting)
+            connection.setblocking(False)
+            selector.register(connection, selectors.EVENT_READ)
+            pending = bytearray()
+            socket_eof = False
+            last_progress = time.monotonic()
+            print('Pointer companion connected; Ctrl-C disconnects.', file=sys.stderr)
+            while True:
+                if pending and time.monotonic() - last_progress >= stall_timeout:
+                    raise RuntimeError('guest companion input stalled')
+                for key, _ in selector.select(1):
+                    if key.fileobj is process.stdout:
+                        data = os.read(process.stdout.fileno(), 4096)
+                        if not data or not layout:
+                            raise RuntimeError('guest companion ended or sent unexpected output: %r' % data)
+                        feedback.extend(data)
+                        forward_layout()
+                        continue
+                    if key.fileobj is connection:
+                        data = connection.recv(4096)
+                        if not data:
+                            selector.unregister(connection)
+                            socket_eof = True
+                            if not pending:
+                                return
+                            continue
+                        if not pending:
+                            last_progress = time.monotonic()
+                            selector.register(process.stdin, selectors.EVENT_WRITE)
+                        pending.extend(data)
+                        if len(pending) > 262144:
+                            raise RuntimeError('guest companion queue exceeded 256 KiB')
+                    else:
+                        try:
+                            written = os.write(process.stdin.fileno(), pending)
+                        except BlockingIOError:
+                            continue
+                        if not written:
+                            raise RuntimeError('guest companion input closed')
+                        del pending[:written]
+                        last_progress = time.monotonic()
+                        if not pending:
+                            selector.unregister(process.stdin)
+                            if socket_eof:
+                                return
+    finally:
+        if connection:
+            connection.close()
+        if layout:
+            layout.close()
+        process.stdin.close()
+        try:
+            process.wait(timeout=3)
+        except subprocess.TimeoutExpired:
+            process.terminate()
+            try:
+                process.wait(timeout=3)
+            except subprocess.TimeoutExpired:
+                process.kill()
+                process.wait()
+        process.stdout.close()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--socket', required=True)
+    parser.add_argument('--ssh-host', required=True)
+    parser.add_argument('--guest-helper', required=True)
+    parser.add_argument('--heads', type=int, default=2)
+    parser.add_argument('--serial-base', type=int, default=1)
+    parser.add_argument('--layout-socket')
+    args = parser.parse_args()
+    if not 1 <= args.heads <= 16 or args.serial_base < 1:
+        parser.error('heads must be 1..16 and serial-base positive')
+    if args.ssh_host.startswith('-'):
+        parser.error('ssh-host must be an SSH host or alias')
+    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
+    try:
+        relay(args.socket, args.ssh_host, args.guest_helper, args.heads, args.serial_base, layout_socket=args.layout_socket)
+    except (OSError, RuntimeError, KeyboardInterrupt) as error:
+        print('Pointer relay stopped: %s' % error, file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
diff --git a/scripts/multimonitor/test_guest_pointer.py b/scripts/multimonitor/test_guest_pointer.py
new file mode 100644
index 0000000000000000000000000000000000000000..acde93f7b06bd7a07f441735342fa709aed31d1f
--- /dev/null
+++ b/scripts/multimonitor/test_guest_pointer.py
@@ -0,0 +1,318 @@
+"""CPU-only protocol and desktop-routing tests; never loads Apple frameworks."""
+import io
+import os
+import threading
+import time
+import unittest
+
+from guest_pointer import Display, Pointer, Relative, display_map, parse_packet, position, relative_position, serve, layout_packet
+
+
+class Backend:
+    double_click_interval = 0.5
+
+    def __init__(self):
+        # Deliberately reverse display IDs and enumeration order. Main is not
+        # necessarily the origin, and logical size differs from backing size.
+        self.current = [Display(91, 4102, 2, -720, -100, 720, 1440),
+                        Display(7, 4102, 1, 0, 0, 1920, 1080)]
+        self.events = []
+        self.native_buttons = 0
+        self.native_point = (450, 620)
+
+    def held_buttons(self):
+        return self.native_buttons
+
+    def pointer_position(self):
+        return self.native_point
+
+    def displays(self):
+        return self.current
+
+    def mouse(self, action, button, point, clicks):
+        self.events.append((action, button, point, clicks))
+        self.native_point = point
+        if action == "down":
+            self.native_buttons |= 1 << button
+        elif action == "up":
+            self.native_buttons &= ~(1 << button)
+
+    def scroll(self, point, x, y):
+        self.events.append(("scroll", point, x, y))
+
+
+class LayoutFeedbackTests(unittest.TestCase):
+    def test_bounds_are_identity_ordered(self):
+        mapping = display_map(Backend().current, 2, 4102, 1)
+        self.assertEqual(layout_packet(mapping), "L 1 2 0 0 0 1920 1080 1 -720 -100 720 1440\n")
+
+    def test_idle_layout_change_and_buffered_button_edges(self):
+        backend = Backend()
+        output = io.StringIO()
+        read_fd, write_fd = os.pipe()
+        errors = []
+        def run():
+            try:
+                with os.fdopen(read_fd, 'rb', buffering=0) as stream:
+                    serve(stream, output, Pointer(backend), report_layout=True)
+            except Exception as error:
+                errors.append(error)
+        thread = threading.Thread(target=run)
+        thread.start()
+        try:
+            deadline = time.monotonic() + 2
+            while 'L 1' not in output.getvalue():
+                self.assertLess(time.monotonic(), deadline)
+                time.sleep(.01)
+            backend.current = [Display(7, 4102, 1, 0, 0, 1920, 1080), Display(91, 4102, 2, 1920, 0, 720, 1440)]
+            while '1 1920 0 720 1440' not in output.getvalue():
+                self.assertLess(time.monotonic(), deadline)
+                time.sleep(.01)
+            os.write(write_fd, b'P 1 1 12000 14000 1 0 0\nP 1 1 12000 14000 0 0 0\n')
+        finally:
+            os.close(write_fd)
+            thread.join(timeout=2)
+        self.assertFalse(thread.is_alive())
+        self.assertFalse(errors, errors)
+        self.assertEqual([e[0] for e in backend.events], ['move', 'down', 'drag', 'up'])
+
+
+class ProtocolTests(unittest.TestCase):
+    def test_reset_and_signed_wheels(self):
+        self.assertIsNone(parse_packet(b"R 1\n", 2))
+        self.assertEqual(parse_packet(b"P 1 1 32767 0 31 -4 9\n", 2),
+                         (1, 32767, 0, 31, -4, 9))
+
+    def test_bad_packets_fail_closed(self):
+        for line in [b"", b"R 2\n", b"R 1 x\n", b"P 1 0 0 0 0 0\n",
+                     b"P 2 0 0 0 0 0 0\n", b"P 1 2 0 0 0 0 0\n",
+                     b"P 1 -1 0 0 0 0 0\n", b"P 1 0 32768 0 0 0 0\n",
+                     b"P 1 0 0 -1 0 0 0\n", b"P 1 0 0 0 32 0 0\n",
+                     b"P 1 0 0 0 0 0 32768\n", b"P 1 0 0 0 0 0 -32768\n",
+                     b"P 1 0 0 0 0 0 1.0\n", b"P 1 0 0 0 0 0 1_0\n",
+                     b"P 1 0 0 0 0 0 0", b"\xff\n", b" " * 161 + b"\n"]:
+            with self.subTest(line=line), self.assertRaises(ValueError):
+                parse_packet(line, 2)
+
+
+class GeometryTests(unittest.TestCase):
+    def test_id_order_never_selects_head(self):
+        backend = Backend()
+        mapping = display_map(backend.current, 2, 4102, 1)
+        self.assertEqual(mapping[0].identifier, 7)
+        self.assertEqual(mapping[1].identifier, 91)
+
+    def test_negative_origins_and_inclusive_endpoints(self):
+        display = Backend().current[0]
+        self.assertEqual(position(display, 0, 0), (-720, -100))
+        self.assertEqual(position(display, 32767, 32767), (-1, 1339))
+        x, y = position(display, 16384, 16384)
+        self.assertAlmostEqual(x, -360.5, delta=0.02)
+        self.assertAlmostEqual(y, 619.5, delta=0.03)
+
+    def test_hidpi_uses_desktop_bounds_not_backing_pixels(self):
+        display = Display(1, 4102, 1, 1920, 0, 1280, 720)
+        self.assertEqual(position(display, 32767, 32767), (3199, 719))
+
+    def test_missing_duplicate_and_mirrored_display_rejected(self):
+        original = Backend().current
+        alternatives = [original[:1], original + [original[0]],
+                        [Display(91, 4102, 2, 0, 0, 720, 1440, True), original[1]],
+                        [Display(91, 4102, 2, 0, 0, 0, 1440), original[1]],
+                        [Display(91, 4102, 2, float("nan"), 0, 720, 1440), original[1]],
+                        [Display(7, 4102, 2, 0, 0, 720, 1440), original[1]]]
+        for displays in alternatives:
+            with self.subTest(displays=displays), self.assertRaises(ValueError):
+                display_map(displays, 2, 4102, 1)
+
+
+class RelativeTests(unittest.TestCase):
+    def setUp(self):
+        self.mapping = {0: Display(1, 4102, 1, 0, 0, 1920, 1080),
+                        1: Display(2, 4102, 2, 1920, 0, 720, 1440)}
+
+    def test_signed_protocol(self):
+        self.assertEqual(parse_packet(b"M 1 0 -5 7 1 0 0\n", 2), Relative(0, -5, 7, 1, 0, 0))
+        with self.assertRaises(ValueError):
+            parse_packet(b"M 1 0 -32768 0 0 0 0\n", 2)
+
+    def test_cross_and_return(self):
+        self.assertEqual(relative_position(self.mapping, (1910, 500), 30, 0), (1, (1940, 500)))
+        self.assertEqual(relative_position(self.mapping, (1940, 500), -50, 0), (0, (1890, 500)))
+
+    def test_unmatched_edge_stops_and_slides(self):
+        self.assertEqual(relative_position(self.mapping, (1930, 1200), -40, 20), (1, (1920, 1220)))
+        self.assertEqual(relative_position(self.mapping, (2630, 500), 100, 20), (1, (2639, 520)))
+
+    def test_negative_and_vertical_layout(self):
+        self.mapping[1] = Display(2, 4102, 2, 0, -1440, 720, 1440)
+        self.assertEqual(relative_position(self.mapping, (100, 10), 0, -40), (1, (100, -30)))
+        self.assertEqual(relative_position(self.mapping, (1000, 10), 0, -40), (0, (1000, 0)))
+
+    def test_large_delta_does_not_jump_gap(self):
+        self.mapping[1] = Display(2, 4102, 2, 2000, 0, 720, 1440)
+        self.assertEqual(relative_position(self.mapping, (1910, 500), 500, 0), (0, (1919, 500)))
+
+    def test_drag_keeps_buttons_and_uses_live_arrangement(self):
+        backend = Backend()
+        backend.current = list(self.mapping.values())
+        pointer = Pointer(backend)
+        pointer.accept((0, 32767, 16384, 1, 0, 0))
+        pointer.accept(Relative(0, 30, 0, 1, 0, 0))
+        self.assertEqual(pointer.head, 1)
+        self.assertEqual(backend.events[-1][0], "drag")
+        pointer.accept(Relative(0, 0, 0, 0, 0, 0))
+        self.assertEqual(backend.events[-1][0], "up")
+        self.assertGreater(backend.events[-1][2][0], 1920)
+        backend.current[1] = Display(2, 4102, 2, -720, 0, 720, 1440)
+        pointer.accept((0, 0, 16384, 0, 0, 0))
+        pointer.accept(Relative(0, -30, 0, 0, 0, 0))
+        self.assertEqual(pointer.head, 1)
+        self.assertEqual(pointer.point[0], -30)
+
+
+class StateTests(unittest.TestCase):
+    def setUp(self):
+        self.backend = Backend()
+        self.now = 10.0
+        self.pointer = Pointer(self.backend, clock=lambda: self.now)
+
+    def packet(self, buttons=0, head=0, x=0, y=0, wx=0, wy=0):
+        self.pointer.accept((head, x, y, buttons, wx, wy))
+
+    def test_all_button_edges_and_release_location(self):
+        self.packet(buttons=31, head=1, x=32767, y=32767)
+        down = [e for e in self.backend.events if e[0] == "down"]
+        self.assertEqual([e[1] for e in down], list(range(5)))
+        self.pointer.reset()
+        up = [e for e in self.backend.events if e[0] == "up"]
+        self.assertEqual([e[1] for e in up], list(range(5)))
+        self.assertTrue(all(e[2] == (-1, 1339) for e in up))
+        self.assertEqual(self.pointer.buttons, 0)
+
+    def test_drag_moves_before_release_and_no_repeated_down(self):
+        self.packet(buttons=1)
+        self.packet(buttons=1, x=10000)
+        self.packet(buttons=0, x=32767)
+        self.assertEqual([e[0] for e in self.backend.events],
+                         ["move", "down", "drag", "drag", "up"])
+        self.assertEqual(self.backend.events[-1][2], (1919, 0))
+
+    def test_right_and_middle_drag(self):
+        for button in (1, 2):
+            self.packet(buttons=1 << button)
+            self.packet(buttons=1 << button, x=100)
+            self.assertEqual(self.backend.events[-1][:2], ("drag", button))
+            self.pointer.reset()
+
+    def test_wheel_axes_and_signs_preserved(self):
+        self.packet(head=1, wx=-2, wy=3)
+        self.assertEqual(self.backend.events[-1], ("scroll", (-720, -100), -2, 3))
+
+    def test_double_click_count_on_down_and_up(self):
+        self.packet(buttons=1)
+        self.packet()
+        self.now += 0.2
+        self.packet(buttons=1)
+        self.packet()
+        clicks = [e[3] for e in self.backend.events if e[0] in ("down", "up")]
+        self.assertEqual(clicks, [1, 1, 2, 2])
+        self.now += 1
+        self.packet(buttons=1)
+        self.assertEqual(self.backend.events[-1][3], 1)
+
+    def test_double_click_does_not_cross_heads_or_distance(self):
+        self.packet(buttons=1)
+        self.packet()
+        self.now += 0.1
+        self.packet(buttons=1, head=1)
+        self.assertEqual(self.backend.events[-1][3], 1)
+        self.packet(head=1)
+        self.packet(buttons=1, head=1, x=32767)
+        self.assertEqual(self.backend.events[-1][3], 1)
+
+    def test_drag_returning_to_origin_is_not_double_click(self):
+        self.packet(buttons=1)
+        self.packet(buttons=1, x=32767)
+        self.packet()
+        self.now += 0.1
+        self.packet(buttons=1)
+        self.assertEqual(self.backend.events[-1][3], 1)
+
+    def test_release_attempts_all_buttons_even_if_backend_fails(self):
+        self.packet(buttons=7)
+        original = self.backend.mouse
+        def fail_one(action, button, point, clicks):
+            original(action, button, point, clicks)
+            if action == "up" and button == 0:
+                raise RuntimeError("injected posting failure")
+        self.backend.mouse = fail_one
+        with self.assertRaises(RuntimeError):
+            self.pointer.reset()
+        self.assertEqual([e[1] for e in self.backend.events if e[0] == "up"], [0, 1, 2])
+        self.assertEqual(self.pointer.buttons, 0)
+
+    def test_display_rearrangement_read_on_each_packet(self):
+        self.packet(head=1)
+        self.backend.current[0] = Display(91, 4102, 2, 1920, -300, 1440, 720)
+        self.packet(head=1)
+        self.assertEqual(self.backend.events[-1][2], (1920, -300))
+
+    def test_reset_packet_clears_click_history(self):
+        self.packet(buttons=1)
+        self.pointer.accept(None)
+        self.packet(buttons=1)
+        self.assertEqual(self.backend.events[-1][3], 1)
+
+    def test_eof_releases_buttons_and_readiness_is_only_stdout(self):
+        output = io.StringIO()
+        serve(io.BytesIO(b"R 1\nP 1 1 0 0 5 0 0\n"), output, self.pointer)
+        self.assertEqual(output.getvalue(), "READY 1\n")
+        self.assertEqual(self.pointer.buttons, 0)
+        self.assertEqual([e[1] for e in self.backend.events if e[0] == "up"], [0, 2])
+
+    def test_malformed_or_truncated_packet_releases_buttons(self):
+        for suffix in (b"P 7\n", b"P 1 0", b"a" * 1000):
+            self.backend.events.clear()
+            with self.assertRaises(ValueError):
+                serve(io.BytesIO(b"P 1 0 0 0 1 0 0\n" + suffix), io.StringIO(), self.pointer)
+            self.assertEqual(self.pointer.buttons, 0)
+            self.assertEqual(self.backend.events[-1][0], "up")
+
+    def test_invalid_initial_map_never_announces_readiness(self):
+        self.backend.current = []
+        output = io.StringIO()
+        with self.assertRaises(ValueError):
+            serve(io.BytesIO(), output, self.pointer)
+        self.assertEqual(output.getvalue(), "")
+
+    def test_startup_recovers_native_buttons_from_crashed_helper(self):
+        self.backend.native_buttons = 31
+        self.backend.native_point = (-255, 700)
+        self.assertEqual(self.pointer.buttons, 0)
+        output = io.StringIO()
+        serve(io.BytesIO(), output, self.pointer)
+        self.assertEqual(output.getvalue(), "READY 1\n")
+        self.assertEqual(self.backend.events,
+                         [("up", button, (-255, 700), 1) for button in range(5)])
+        self.assertEqual(self.backend.native_buttons, 0)
+
+    def test_reset_queries_native_state_without_spurious_releases(self):
+        self.pointer.reset()
+        self.assertEqual(self.backend.events, [])
+        self.backend.native_buttons = 18
+        self.backend.native_point = (2000, 650)
+        self.pointer.accept(None)
+        self.assertEqual(self.backend.events,
+                         [("up", 1, (2000, 650), 1), ("up", 4, (2000, 650), 1)])
+
+    def test_hot_unplug_releases_at_last_known_position(self):
+        self.packet(buttons=1, head=1)
+        self.backend.current = []
+        with self.assertRaises(ValueError):
+            serve(io.BytesIO(b"P 1 1 1 1 1 0 0\n"), io.StringIO(), self.pointer)
+        self.assertEqual(self.backend.events[-1], ("up", 0, (-720, -100), 1))
+
+
+if __name__ == "__main__":
+    unittest.main()
