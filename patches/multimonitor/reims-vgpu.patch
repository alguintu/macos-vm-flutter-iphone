@@ -0,0 +1,117 @@
+"""Exercise readiness framing and ordered transport with a local helper process."""
+from pathlib import Path
+import socket
+import subprocess
+import sys
+import tempfile
+import threading
+import unittest
+from unittest.mock import patch
+
+from relay import relay
+
+
+class RelayTests(unittest.TestCase):
+    def helper(self, code):
+        return subprocess.Popen([sys.executable, '-u', '-c', code],
+                                stdin=subprocess.PIPE, stdout=subprocess.PIPE, bufsize=0)
+
+    def test_fragmented_readiness_and_ordered_button_edges(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = directory + '/pointer'
+            result = directory + '/received'
+            process = self.helper(
+                "import sys,time,pathlib; "
+                "sys.stdout.write('REA');sys.stdout.flush();time.sleep(.03);"
+                "sys.stdout.write('DY 1\\n');sys.stdout.flush();"
+                f"pathlib.Path({result!r}).write_bytes(sys.stdin.buffer.read())")
+            listener = socket.socket(socket.AF_UNIX)
+            listener.bind(path)
+            listener.listen(1)
+            listener.settimeout(3)
+            packets = b'R 1\nP 1 0 200 200 1 0 0\nM 1 0 30 0 1 0 0\nM 1 0 0 0 0 0 0\n'
+            errors = []
+
+            def server():
+                try:
+                    connection, _ = listener.accept()
+                    with connection:
+                        self.assertEqual(connection.recv(32), b'READY 1\n')
+                        connection.sendall(packets)
+                except Exception as error:
+                    errors.append(error)
+
+            thread = threading.Thread(target=server)
+            thread.start()
+            try:
+                with patch('relay.subprocess.Popen', return_value=process):
+                    relay(path, 'guest', '/helper', 2, 1)
+            finally:
+                thread.join(timeout=4)
+                listener.close()
+            self.assertFalse(thread.is_alive())
+            self.assertFalse(errors, errors)
+            self.assertEqual(Path(result).read_bytes(), packets)
+
+    def test_layout_feedback_can_share_readiness_and_arrive_fragmented(self):
+        with tempfile.TemporaryDirectory() as directory:
+            pointer_path = directory + '/pointer'
+            layout_path = directory + '/layout'
+            result = directory + '/received'
+            process = self.helper(
+                "import sys,time,pathlib; "
+                "sys.stdout.write('READY 1\\nL 1 1 0 0 0 ');sys.stdout.flush();time.sleep(.03);"
+                "sys.stdout.write('1920 1080\\n');sys.stdout.flush();"
+                f"pathlib.Path({result!r}).write_bytes(sys.stdin.buffer.read())")
+            listeners = []
+            for path in (pointer_path, layout_path):
+                listener = socket.socket(socket.AF_UNIX)
+                listener.bind(path)
+                listener.listen(1)
+                listener.settimeout(3)
+                listeners.append(listener)
+            received = bytearray()
+            errors = []
+            def server():
+                try:
+                    control, _ = listeners[1].accept()
+                    pointer, _ = listeners[0].accept()
+                    with control, pointer:
+                        control.settimeout(3)
+                        self.assertEqual(pointer.recv(32), b'READY 1\n')
+                        while not received.endswith(b'\n'):
+                            received.extend(control.recv(4096))
+                        pointer.sendall(b'R 1\n')
+                except Exception as error:
+                    errors.append(error)
+            thread = threading.Thread(target=server)
+            thread.start()
+            try:
+                with patch('relay.subprocess.Popen', return_value=process):
+                    relay(pointer_path, 'guest', '/helper', 1, 1, layout_socket=layout_path)
+            finally:
+                thread.join(timeout=4)
+                for listener in listeners:
+                    listener.close()
+            self.assertFalse(thread.is_alive())
+            self.assertFalse(errors, errors)
+            self.assertEqual(received, b'L 1 1 0 0 0 1920 1080\n')
+            self.assertEqual(Path(result).read_bytes(), b'R 1\n')
+
+    def test_partial_readiness_times_out(self):
+        process = self.helper("import sys,time;sys.stdout.write('REA');sys.stdout.flush();time.sleep(10)")
+        with patch('relay.subprocess.Popen', return_value=process):
+            with self.assertRaisesRegex(RuntimeError, 'did not become ready'):
+                relay('/unused', 'guest', '/helper', 2, 1, ready_timeout=.05)
+        self.assertIsNotNone(process.poll())
+
+    def test_invalid_readiness_never_connects(self):
+        process = self.helper("print('NO')")
+        with patch('relay.subprocess.Popen', return_value=process):
+            with self.assertRaisesRegex(RuntimeError, 'refused startup'):
+                relay('/unused', 'guest', '/helper', 2, 1)
+        self.assertIsNotNone(process.poll())
+
+
+if __name__ == '__main__':
+    unittest.main()
