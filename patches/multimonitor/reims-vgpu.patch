+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn map() -> Vec<Monitor> {
+        parse_layout("L 1 2 0 0 0 1920 1080 1 1920 0 720 1440\n").unwrap()
+    }
+    #[test]
+    fn crosses_and_returns_without_losing_distance() {
+        let m = map();
+        let a = advance(&m, (1879.0, 540.0), (80.0, 0.0)).unwrap();
+        assert_eq!(a, (1, (1959.0, 540.0)));
+        assert_eq!(advance(&m, a.1, (-80.0, 0.0)), Some((0, (1879.0, 540.0))));
+    }
+    #[test]
+    fn gaps_stop_and_walls_slide() {
+        let mut m = map();
+        m[1].bounds.x = 2000.0;
+        assert_eq!(
+            advance(&m, (1900.0, 500.0), (150.0, 60.0)),
+            Some((0, (1920.0_f64.next_down(), 560.0)))
+        );
+        assert_eq!(
+            advance(&map(), (1900.0, 1070.0), (100.0, 100.0)),
+            Some((1, (2000.0, 1080.0)))
+        );
+    }
