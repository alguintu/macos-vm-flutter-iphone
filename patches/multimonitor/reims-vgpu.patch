+        let windows: Vec<_> = (0..2)
+            .map(|head| {
+                let events = events.clone();
+                Window::new(
+                    WindowConfig {
+                        callbacks: WindowCallbacks {
+                            pointer: Some(Arc::new(move |x, y, w, h, buttons| {
+                                events.lock().unwrap().push((head, x, y, w, h, buttons))
+                            })),
+                            ..WindowCallbacks::default()
+                        },
+                        ..WindowConfig::default()
+                    },
+                    head,
+                    String::new(),
+                )
+            })
+            .collect();
+        DESKTOP.with(|d| {
+            let mut d = d.borrow_mut();
+            *d = Desktop {
+                map: map(),
+                ..Desktop::default()
+            };
+            for w in &windows {
+                d.views.insert(
+                    w.port(),
+                    View {
