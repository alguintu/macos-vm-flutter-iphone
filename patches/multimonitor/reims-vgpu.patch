+"""CPU-only QMP integration check for the separately built QEMU bridge."""
+import socket, subprocess, tempfile, json, time, os
+from pathlib import Path
+import argparse
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--qemu', required=True)
+    parser.add_argument('--firmware-dir', required=True)
+    options = parser.parse_args()
+    binary = options.qemu
+    with tempfile.TemporaryDirectory(prefix='reims-pointer-test-') as temp:
+        qpath = temp + '/qmp'
+        ppath = temp + '/pointer'
+        args = [binary, '-machine', 'pc', '-accel', 'tcg', '-m', '64', '-nodefaults', '-device', json.dumps({'driver': 'virtio-gpu-pci', 'id': 'gfx', 'max_outputs': 2}), '-display', 'none', '-S', '-L', options.firmware_dir, '-qmp', f'unix:{qpath},server=on,wait=off', '-chardev', f'socket,id=pointer,path={ppath},server=on,wait=off', '-device', 'reims-pointer,display=gfx,heads=2,chardev=pointer']
+        p = subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
+        try:
+            for _ in range(100):
+                if Path(qpath).exists():
+                    break
+                if p.poll() is not None:
+                    raise RuntimeError(p.stderr.read().decode())
+                time.sleep(0.05)
+            q = socket.socket(socket.AF_UNIX)
+            q.settimeout(3)
+            q.connect(qpath)
+            f = q.makefile('rwb')
+            f.readline()
+
+            def cmd(c, a=None):
+                f.write((json.dumps({'execute': c, **({'arguments': a} if a else {})}) + '\n').encode())
+                f.flush()
+                while True:
+                    r = json.loads(f.readline())
+                    if 'return' in r:
+                        return r['return']
+                    if 'error' in r:
+                        raise RuntimeError(r)
+            cmd('qmp_capabilities')
+            cmd('cont')
+            s = socket.socket(socket.AF_UNIX)
+            s.settimeout(3)
+            s.connect(ppath)
+            s.sendall(b'READY 1\n')
+            sf = s.makefile('rb')
+            assert sf.readline() == b'R 1\n'
+
+            def events(es):
+                cmd('input-send-event', {'device': 'gfx', 'head': 0, 'events': es})
+            events([{'type': 'abs', 'data': {'axis': 'x', 'value': 16384}}, {'type': 'abs', 'data': {'axis': 'y', 'value': 8192}}])
+            assert sf.readline() == b'P 1 0 16384 8192 0 0 0\n'
+            events([{'type': 'btn', 'data': {'button': 'left', 'down': True}}, {'type': 'btn', 'data': {'button': 'left', 'down': False}}])
+            assert sf.readline() == b'P 1 0 16384 8192 1 0 0\n'
+            assert sf.readline() == b'P 1 0 16384 8192 0 0 0\n'
+            events([{'type': 'btn', 'data': {'button': 'wheel-up', 'down': True}}, {'type': 'btn', 'data': {'button': 'wheel-up', 'down': False}}])
+            assert sf.readline() == b'P 1 0 16384 8192 0 0 1\n'
+            cmd('input-send-event', {'device': 'gfx', 'head': 1, 'events': [{'type': 'abs', 'data': {'axis': 'x', 'value': 24576}}, {'type': 'abs', 'data': {'axis': 'y', 'value': 16384}}]})
+            assert sf.readline() == b'P 1 1 24576 16384 0 0 0\n'
+            events([{'type': 'rel', 'data': {'axis': 'x', 'value': 30}}, {'type': 'rel', 'data': {'axis': 'y', 'value': -5}}])
+            assert sf.readline() == b'M 1 0 30 -5 0 0 0\n'
+            events([{'type': 'btn', 'data': {'button': 'left', 'down': True}}, {'type': 'btn', 'data': {'button': 'left', 'down': False}}])
+            assert sf.readline() == b'M 1 0 0 0 1 0 0\n'
+            assert sf.readline() == b'M 1 0 0 0 0 0 0\n'
+            s.shutdown(socket.SHUT_RDWR)
+            sf.close()
+            s.close()
+            time.sleep(0.1)
+            s = socket.socket(socket.AF_UNIX)
+            s.settimeout(3)
+            s.connect(ppath)
+            s.sendall(b'INVALID\n')
+            assert s.recv(100) == b''
+            s.close()
+            time.sleep(0.1)
+            s = socket.socket(socket.AF_UNIX)
+            s.settimeout(3)
+            s.connect(ppath)
+            s.sendall(b'REA')
+            time.sleep(0.02)
+            s.sendall(b'DY 1\n')
+            assert s.recv(100) == b'R 1\n'
+            s.close()
+            cmd('quit')
+            p.wait(timeout=3)
+            print('PASS: QEMU realize, absolute coordinates, batched click edges, wheel, disconnect, invalid/fragmented greetings')
+        finally:
+            if p.poll() is None:
+                p.terminate()
+                p.wait(timeout=3)
+
+
+if __name__ == "__main__":
+    main()
