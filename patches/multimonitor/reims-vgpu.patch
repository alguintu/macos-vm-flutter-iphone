+//! Opt-in local cursor and absolute routing across the companion's guest desktop.
+//!
+//! The UI thread owns all state and SDL objects. A bounded local stream carries only display
+//! bounds, never pointer motion. Mouse events update the local position and the coordinates sent
+//! to the guest together; cursor movement does not wait for a guest frame or acknowledgement.
+use std::cell::RefCell;
+use std::collections::BTreeMap;
