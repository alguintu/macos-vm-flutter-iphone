+
+use super::input::{self, ToHost};
+use crate::geometry::Rect;
+use crate::handle::{Glyph, Window};
+
+/// An explicit private socket path opts into this experimental path.
+pub fn enabled() -> bool {
+    std::env::var_os("REIMS_VGPU_HOST_CURSOR_SOCKET").is_some()
+}
+
+#[derive(Clone, Debug, PartialEq)]
+struct Monitor {
+    head: u64,
+    bounds: Rect,
+}
+
+/// Strict, bounded layout frames: L 1 COUNT followed by HEAD X Y WIDTH HEIGHT per display.
+fn parse_layout(line: &str) -> Option<Vec<Monitor>> {
+    if line.len() > 4096 || !line.ends_with('\n') {
+        return None;
+    }
+    let words: Vec<_> = line.split_whitespace().collect();
+    if words.len() < 3 || words[0..2] != ["L", "1"] {
+        return None;
+    }
+    let count: usize = words[2].parse().ok()?;
+    if !(1..=16).contains(&count) || words.len() != 3 + 5 * count {
+        return None;
+    }
+    let mut map = Vec::new();
+    for row in words[3..].chunks_exact(5) {
+        let head: u64 = row[0].parse().ok()?;
+        let mut v = [0.0_f64; 4];
+        for (to, from) in v.iter_mut().zip(&row[1..]) {
+            *to = from.parse().ok()?;
+        }
+        if head >= 16
+            || map.iter().any(|m: &Monitor| m.head == head)
+            || v.iter().any(|n| !n.is_finite() || n.abs() > 1_000_000.0)
+            || v[2] < 1.0
+            || v[3] < 1.0
+        {
+            return None;
+        }
+        map.push(Monitor {
+            head,
+            bounds: Rect {
+                x: v[0],
+                y: v[1],
+                width: v[2],
+                height: v[3],
+            },
+        });
+    }
+    Some(map)
+}
+
+/// Sweep the motion segment through touching rectangles, then slide along an exterior wall.
+/// This matches the companion's relative geometry, including gaps and negative origins.
+fn advance(map: &[Monitor], point: (f64, f64), delta: (f64, f64)) -> Option<(u64, (f64, f64))> {
+    fn sweep(map: &[Monitor], p: (f64, f64), d: (f64, f64)) -> ((f64, f64), f64) {
+        let mut intervals = Vec::new();
+        for m in map {
+            let b = m.bounds;
+            let (mut lo, mut hi) = (0.0_f64, 1.0_f64);
+            for (p, d, low, high) in [
+                (p.0, d.0, b.x, b.x + b.width),
+                (p.1, d.1, b.y, b.y + b.height),
+            ] {
+                if d == 0.0 {
+                    if p < low || p > high {
+                        hi = -1.0;
+                        break;
+                    }
+                } else {
+                    let a = (low - p) / d;
+                    let b = (high - p) / d;
+                    lo = lo.max(a.min(b));
+                    hi = hi.min(a.max(b));
+                }
+            }
+            if lo <= hi {
+                intervals.push((lo, hi));
+            }
+        }
+        intervals.sort_by(|a, b| a.0.total_cmp(&b.0));
+        let mut end = 0.0_f64;
+        for (lo, hi) in intervals {
+            if lo > end + 1e-9 {
+                break;
+            }
+            end = end.max(hi);
+        }
+        ((p.0 + d.0 * end, p.1 + d.1 * end), end)
+    }
+    if map.is_empty()
+        || ![point.0, point.1, delta.0, delta.1]
+            .iter()
+            .all(|v| v.is_finite())
+    {
+        return None;
+    }
+    let (mut reached, t) = sweep(map, point, delta);
+    if t < 1.0 {
+        let a = sweep(map, reached, (delta.0 * (1.0 - t), 0.0)).0;
+        let b = sweep(map, reached, (0.0, delta.1 * (1.0 - t))).0;
+        reached = if (a.0 - reached.0).hypot(a.1 - reached.1)
+            >= (b.0 - reached.0).hypot(b.1 - reached.1)
+        {
+            a
+        } else {
+            b
+        };
+    }
+    map.iter()
+        .map(|m| {
+            let b = m.bounds;
+            let p = (
+                reached.0.clamp(b.x, (b.x + b.width).next_down()),
+                reached.1.clamp(b.y, (b.y + b.height).next_down()),
+            );
+            (m.head, p)
+        })
+        .min_by(|a, b| {
+            (a.1.0 - reached.0)
+                .hypot(a.1.1 - reached.1)
+                .total_cmp(&(b.1.0 - reached.0).hypot(b.1.1 - reached.1))
+        })
+}
+
+/// Quantize through the existing QEMU absolute callback. The overlay uses the same normalized
+/// integer coordinate the guest receives, including QEMU's inclusive range conversion.
+fn encode(bounds: Rect, point: (f64, f64)) -> ((u16, u16), (f64, f64)) {
+    let axis = |p: f64, origin: f64, size: f64| {
+        let n = if size <= 1.0 {
+            0
+        } else {
+            ((p - origin) / (size - 1.0) * 32767.0)
+                .round()
+                .clamp(0.0, 32766.0) as u16
+        };
+        // floor((n+1)*32767/32768) == n for n in 0..32766.
+        (n + 1, origin + f64::from(n) * (size - 1.0) / 32767.0)
+    };
+    let (x, px) = axis(point.0, bounds.x, bounds.width);
+    let (y, py) = axis(point.1, bounds.y, bounds.height);
+    ((x, y), (px, py))
+}
+
+struct View {
+    window: Weak<Window>,
+    parent: *mut SDL_Window,
+    image: Rect,
+    glyph: Option<Arc<Glyph>>,
+    visible: bool,
+    overlay: Option<Overlay>,
+    overlay_failed: bool,
+}
+
+#[derive(Default)]
+struct Desktop {
+    views: BTreeMap<u64, View>,
+    map: Vec<Monitor>,
+    point: Option<(u64, (f64, f64))>,
+    drawn: Option<(u64, (f64, f64))>,
+    captured: Option<u64>,
+    dirty: bool,
+    glyph: Option<Arc<Glyph>>,
+}
+
+thread_local! { static DESKTOP: RefCell<Desktop> = RefCell::new(Desktop::default()); }
+
+fn start() {
+    static STARTED: OnceLock<()> = OnceLock::new();
+    STARTED.get_or_init(|| {
+        let Some(path) = std::env::var_os("REIMS_VGPU_HOST_CURSOR_SOCKET") else {
+            return;
+        };
+        let listener = match UnixListener::bind(&path) {
+            Ok(l) => l,
+            Err(e) => {
+                log::error!("local cursor layout socket: {e}");
+                return;
+            }
+        };
+        if let Err(e) = std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o600)) {
+            log::error!("local cursor socket permissions: {e}");
+            return;
+        }
+        let _ = std::thread::Builder::new()
+            .name("reims-cursor-map".into())
+            .spawn(move || {
+                for stream in listener.incoming().flatten() {
+                    let mut input = BufReader::new(stream);
+                    loop {
+                        let mut line = String::new();
+                        if input
+                            .by_ref()
+                            .take(4097)
+                            .read_line(&mut line)
+                            .ok()
+                            .unwrap_or(0)
+                            == 0
+                        {
+                            break;
+                        }
+                        let Some(map) = parse_layout(&line) else {
+                            break;
+                        };
+                        super::ui::post(move || replace_layout(map));
+                    }
+                    super::ui::post(|| replace_layout(Vec::new()));
+                }
+            });
+    });
+}
+
+/// A changed arrangement or lost companion releases capture before using another geometry.
+fn replace_layout(map: Vec<Monitor>) {
+    let capture = DESKTOP.with(|d| {
+        let mut d = d.borrow_mut();
+        if d.map == map {
+            return None;
+        }
+        d.release();
+        let id = d
+            .captured
+            .and_then(|head| d.views.get(&head))
+            .and_then(|v| v.window.upgrade())
+            .map(|w| w.id());
+        d.map = map;
+        d.point = None;
+        d.drawn = None;
+        d.captured = None;
+        d.hide();
+        log::info!(
+            "local cursor: {} guest display bounds received",
+            d.map.len()
+        );
+        id
+    });
+    if let Some(id) = capture {
+        crate::sdl::shell::with_shell(id, |shell| {
+            shell.input.closing();
+            shell.flush();
+            shell.capture_changed();
+        });
+    }
+}
+
+/// Register/update a live SDL parent and its image rectangle, only on SDL's UI thread.
+pub(crate) fn register(window: &Arc<Window>, parent: *mut SDL_Window, image: Rect) {
+    if !enabled() {
+        return;
+    }
+    start();
+    let guest = window.guest();
+    let glyph = guest.cursor.map(Arc::new);
+    DESKTOP.with(|d| {
+        let mut d = d.borrow_mut();
+        let view = d.views.entry(window.port()).or_insert_with(|| View {
+            window: Arc::downgrade(window),
+            parent,
+            image,
+            glyph: glyph.clone(),
+            visible: guest.cursor_visible,
+            overlay: None,
+            overlay_failed: false,
+        });
+        view.image = image;
+        if d.glyph.is_none() {
+            d.glyph = glyph;
+        }
+        d.dirty = true;
+    });
+}
+
+/// Destroy the child before SDL destroys its parent.
+pub(crate) fn remove(head: u64) {
+    if !enabled() {
+        return;
+    }
+    DESKTOP.with(|d| {
+        let mut d = d.borrow_mut();
+        d.release();
+        d.views.remove(&head);
+        d.point = None;
+        d.drawn = None;
+        d.hide();
+    });
+}
+
+pub(crate) fn capture(head: u64, captured: bool) {
+    if !enabled() {
+        return;
+    }
+    DESKTOP.with(|d| {
+        let mut d = d.borrow_mut();
+        if captured {
+            d.captured = Some(head);
+            d.dirty = true;
+        } else if d.captured == Some(head) {
+            d.captured = None;
+            d.hide();
+        }
+    });
+}
+
+/// The most recent guest glyph is available immediately when the pointer crosses a head whose
+/// cursor shape has not changed. Cursor shape feedback remains asynchronous, as for native SDL.
+pub(crate) fn glyph(window: &Window) {
+    if !enabled() {
+        return;
+    }
+    let guest = window.guest();
+    DESKTOP.with(|d| {
+        let mut d = d.borrow_mut();
+        let Some(view) = d.views.get_mut(&window.port()) else {
+            return;
+        };
+        view.visible = guest.cursor_visible;
+        if let Some(g) = guest.cursor {
+            if view.glyph.as_deref() != Some(&g) {
+                view.glyph = Some(Arc::new(g));
+            }
+            d.glyph = view.glyph.clone();
+        }
+        d.dirty = true;
+    });
+}
+
+/// Route pointer/button coordinates locally; keys continue to the capturing window.
+pub(crate) fn send(window: &Window, events: Vec<ToHost>) {
+    DESKTOP.with(|d| {
+        let mut d = d.borrow_mut();
+        for event in events {
+            match event {
+                ToHost::Pointer { at, mode, buttons } => {
+                    let Some(m) = d.map.iter().find(|m| m.head == window.port()) else {
+                        continue;
+                    };
+                    let b = m.bounds;
+                    let nx = u32::from(at.0) * 32767 / u32::from(mode.0.max(1));
+                    let ny = u32::from(at.1) * 32767 / u32::from(mode.1.max(1));
+                    d.point = Some((
+                        window.port(),
+                        (
+                            b.x + f64::from(nx) * (b.width - 1.0) / 32767.0,
+                            b.y + f64::from(ny) * (b.height - 1.0) / 32767.0,
+                        ),
+                    ));
+                    d.emit(buttons);
+                }
+                ToHost::Relative { dx, dy, buttons } => {
+                    let Some((head, p)) = d.point else {
+                        continue;
+                    };
+                    let Some(m) = d.map.iter().find(|m| m.head == head) else {
+                        continue;
+                    };
+                    let Some(view) = d.views.get(&head) else {
+                        continue;
+                    };
+                    if view.image.width <= 0.0 || view.image.height <= 0.0 {
+                        continue;
+                    }
+                    let delta = (
+                        dx * m.bounds.width / view.image.width,
+                        dy * m.bounds.height / view.image.height,
+                    );
+                    d.point = advance(&d.map, p, delta);
+                    d.emit(buttons);
+                }
+                ToHost::Wheel { .. } => {
+                    let head = if d.captured.is_some() {
+                        d.point.map(|p| p.0).unwrap_or(window.port())
+                    } else {
+                        window.port()
+                    };
+                    if let Some(w) = d.views.get(&head).and_then(|v| v.window.upgrade())
+                        && let Some(cb) = w.callbacks()
+                    {
+                        input::send(&cb, vec![event]);
+                    }
+                }
+                ToHost::Key(_) => {
+                    if let Some(cb) = window.callbacks() {
+                        input::send(&cb, vec![event]);
+                    }
+                }
+            }
+        }
+    });
+}
+
+impl Desktop {
+    fn emit(&mut self, buttons: u32) {
+        let Some((head, p)) = self.point else {
+            return;
+        };
+        let Some(m) = self.map.iter().find(|m| m.head == head) else {
+            return;
+        };
+        let Some(w) = self.views.get(&head).and_then(|v| v.window.upgrade()) else {
+            return;
+        };
+        let Some(cb) = w.callbacks().and_then(|c| c.pointer) else {
+            return;
+        };
+        let (at, shown) = encode(m.bounds, p);
+        cb(at.0, at.1, 32768, 32768, buttons);
+        self.drawn = Some((head, shown));
+        self.dirty = true;
+    }
+    fn release(&mut self) {
+        self.emit(0);
+    }
+    fn hide(&mut self) {
+        for view in self.views.values_mut() {
+            if let Some(o) = &mut view.overlay {
+                o.hide();
+            }
+        }
+    }
+    fn render(&mut self) {
+        if !self.dirty {
+            return;
+        }
+        self.dirty = false;
+        let visible = self.views.values().any(|v| v.visible);
+        let Some((head, point)) = self.drawn.filter(|_| self.captured.is_some() && visible) else {
+            self.hide();
+            return;
+        };
+        let Some(m) = self.map.iter().find(|m| m.head == head) else {
+            self.hide();
+            return;
+        };
+        let b = m.bounds;
+        let glyph = &self.glyph;
+        for (&h, view) in &mut self.views {
+            if h != head {
+                if let Some(o) = &mut view.overlay {
+                    o.hide();
+                }
+                continue;
+            }
+            let Some(g) = view.glyph.as_ref().or(glyph.as_ref()) else {
+                continue;
+            };
+            let position = (
+                view.image.x + (point.0 - b.x) * view.image.width / b.width,
+                view.image.y + (point.1 - b.y) * view.image.height / b.height,
+            );
+            if view.overlay.is_none() && !view.overlay_failed {
+                view.overlay = Overlay::new(view.parent);
+                view.overlay_failed = view.overlay.is_none();
+            }
+            if let Some(o) = &mut view.overlay {
+                if view.overlay_failed {
+                    continue;
+                }
+                let mode = view
+                    .window
+                    .upgrade()
+                    .and_then(|w| w.mode())
+                    .unwrap_or((1, 1));
+                let scale = view.image.width / f64::from(mode.0.max(1));
+                o.show(g, position, scale);
+                view.overlay_failed = o.failed;
+            }
+        }
+    }
+}
+
+/// Called after SDL input batches AND UI jobs, including frames arriving on an idle desktop.
+pub(crate) fn render() {
+    if !enabled() {
+        return;
+    }
+    let failed_capture = DESKTOP.with(|d| {
+        let mut d = d.borrow_mut();
+        d.render();
+        if d.captured.is_some() && d.views.values().any(|v| v.overlay_failed) {
+            let id = d
+                .captured
+                .and_then(|head| d.views.get(&head))
+                .and_then(|v| v.window.upgrade())
+                .map(|w| w.id());
+            d.release();
+            d.captured = None;
+            d.hide();
+            id
+        } else {
+            None
+        }
+    });
+    if let Some(id) = failed_capture {
+        crate::sdl::shell::with_shell(id, |shell| {
+            shell.input.closing();
+            shell.flush();
+            shell.capture_changed();
+        });
+    }
+}
+
+/// Handle redraws of our child surfaces after an asynchronous compositor resize/exposure.
+pub(crate) fn event(event: &SDL_Event) -> bool {
+    if !enabled() {
+        return false;
+    }
+    // SAFETY: SDL window events share SDL_WindowEvent's type/id layout.
+    let kind = unsafe { event.r#type };
+    if !(SDL_EVENT_WINDOW_FIRST.0..=SDL_EVENT_WINDOW_LAST.0).contains(&kind) {
+        return false;
+    }
+    let id = unsafe { event.window.windowID };
+    DESKTOP.with(|d| {
+        let mut d = d.borrow_mut();
+        for view in d.views.values_mut() {
+            if let Some(o) = &mut view.overlay {
+                // SAFETY: the live child, on SDL's UI thread.
+                if unsafe { SDL_GetWindowID(o.window) } == id {
+                    if [
+                        SDL_EVENT_WINDOW_EXPOSED.0,
+                        SDL_EVENT_WINDOW_PIXEL_SIZE_CHANGED.0,
+                    ]
+                    .contains(&kind)
+                    {
+                        o.glyph = None;
+                        d.dirty = true;
+                    }
+                    return true;
+                }
+            }
+        }
+        false
+    })
+}
+
+/// A transparent, noninteractive SDL child. It is separate from the VM's Vulkan swapchain;
+/// moving it or replacing its tiny image never requests a new guest/display frame.
+struct Overlay {
+    window: *mut SDL_Window,
+    glyph: Option<Arc<Glyph>>,
+    scale: f64,
+    visible: bool,
+    position: Option<(i32, i32)>,
+    size: (i32, i32),
+    failed: bool,
+}
+impl Overlay {
+    fn new(parent: *mut SDL_Window) -> Option<Self> {
+        // SAFETY: all SDL handles are created, used and destroyed on SDL's UI thread.
+        unsafe {
+            let props = SDL_CreateProperties();
+            SDL_SetPointerProperty(props, SDL_PROP_WINDOW_CREATE_PARENT_POINTER, parent.cast());
+            SDL_SetBooleanProperty(props, SDL_PROP_WINDOW_CREATE_TOOLTIP_BOOLEAN, true);
+            SDL_SetBooleanProperty(props, SDL_PROP_WINDOW_CREATE_TRANSPARENT_BOOLEAN, true);
+            SDL_SetBooleanProperty(props, SDL_PROP_WINDOW_CREATE_HIDDEN_BOOLEAN, true);
+            SDL_SetBooleanProperty(props, SDL_PROP_WINDOW_CREATE_CONSTRAIN_POPUP_BOOLEAN, false);
+            SDL_SetNumberProperty(props, SDL_PROP_WINDOW_CREATE_WIDTH_NUMBER, 32);
+            SDL_SetNumberProperty(props, SDL_PROP_WINDOW_CREATE_HEIGHT_NUMBER, 32);
+            let window = SDL_CreateWindowWithProperties(props);
+            SDL_DestroyProperties(props);
+            if window.is_null() {
+                log::error!("local cursor overlay: {}", crate::sdl::sdl_error());
+                return None;
+            }
+            log::info!("local cursor: transparent SDL child created");
+            Some(Self {
+                window,
+                glyph: None,
+                scale: 0.0,
+                visible: false,
+                position: None,
+                size: (32, 32),
+                failed: false,
+            })
+        }
+    }
+    fn hide(&mut self) {
+        if self.visible {
+            unsafe {
+                SDL_HideWindow(self.window);
+            }
+            self.visible = false;
+        }
+    }
+    fn show(&mut self, glyph: &Arc<Glyph>, point: (f64, f64), scale: f64) {
+        if glyph.width == 0
+            || glyph.height == 0
+            || glyph.width > 256
+            || glyph.height > 256
+            || glyph.rgba.len() != glyph.width as usize * glyph.height as usize * 4
+            || !scale.is_finite()
+            || scale <= 0.0
+        {
+            self.hide();
+            return;
+        }
+        let width = (f64::from(glyph.width) * scale).round().clamp(1.0, 512.0) as i32;
+        let height = (f64::from(glyph.height) * scale).round().clamp(1.0, 512.0) as i32;
+        // SAFETY: SDL's UI thread; glyph bytes remain alive until the synchronous blit ends.
+        unsafe {
+            let position = (
+                (point.0 - f64::from(glyph.hot_spot.0) * scale).round() as i32,
+                (point.1 - f64::from(glyph.hot_spot.1) * scale).round() as i32,
+            );
+            if self.position != Some(position) {
+                SDL_SetWindowPosition(self.window, position.0, position.1);
+                self.position = Some(position);
+            }
+            if !self.glyph.as_ref().is_some_and(|g| Arc::ptr_eq(g, glyph))
+                || self.scale != scale
+                || !self.visible
+            {
+                if self.size != (width, height) {
+                    SDL_SetWindowSize(self.window, width, height);
+                    self.size = (width, height);
+                }
+                if !self.visible {
+                    SDL_ShowWindow(self.window);
+                    self.visible = true;
+                }
+                let dest = SDL_GetWindowSurface(self.window);
+                if dest.is_null() {
+                    log::error!("local cursor surface: {}", crate::sdl::sdl_error());
+                    self.failed = true;
+                    self.hide();
+                    return;
+                }
+                SDL_SetWindowSurfaceVSync(self.window, 0);
+                SDL_FillSurfaceRect(dest, std::ptr::null(), 0);
+                let source = SDL_CreateSurfaceFrom(
+                    glyph.width as i32,
+                    glyph.height as i32,
+                    SDL_PIXELFORMAT_RGBA32,
+                    glyph.rgba.as_ptr().cast_mut().cast(),
+                    glyph.width as i32 * 4,
+                );
+                if !source.is_null() {
+                    SDL_SetSurfaceBlendMode(source, SDL_BLENDMODE_NONE);
+                    SDL_BlitSurfaceScaled(
+                        source,
+                        std::ptr::null(),
+                        dest,
+                        std::ptr::null(),
+                        SDL_SCALEMODE_NEAREST,
+                    );
+                    SDL_DestroySurface(source);
+                    if !SDL_UpdateWindowSurface(self.window) {
+                        log::error!("local cursor update: {}", crate::sdl::sdl_error());
+                        self.failed = true;
+                    }
+                } else {
+                    log::error!("local cursor image: {}", crate::sdl::sdl_error());
+                    self.failed = true;
+                }
+                self.glyph = Some(glyph.clone());
+                self.scale = scale;
+            }
+        }
+    }
+}
+impl Drop for Overlay {
+    fn drop(&mut self) {
+        unsafe {
+            SDL_DestroyWindow(self.window);
+        }
+    }
+}
