+    fn displayed_coordinates_match_wire_quantization() {
+        let b = Rect {
+            x: -1920.0,
+            y: -100.0,
+            width: 1920.0,
+            height: 1080.0,
+        };
+        for i in 0..32767u32 {
+            let p = (b.x + f64::from(i) * (b.width - 1.0) / 32767.0, b.y + 53.25);
+            let (at, shown) = encode(b, p);
+            let nx = u32::from(at.0) * 32767 / 32768;
+            assert_eq!(nx, i);
+            assert_eq!(shown.0, b.x + f64::from(nx) * (b.width - 1.0) / 32767.0);
+        }
+    }
