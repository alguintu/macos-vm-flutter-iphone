                 atomic: u.atomic,
-                window: escaped_window(window::window(u.extent, arg.buffer_size, dynamic), &u),
+                // A device reference's `air.buffer_size` is its pointee's nominal size, and a
+                // trailing one-element array is how SPIRV-Cross (impellerc, MoltenVK's peers)
+                // spells a runtime array: Metal reads past it into the bound buffer. Only a
+                // constant reference bounds its dynamic accesses; a device one is contained by
+                // its binding's own extent.
+                window: escaped_window(
+                    window::window(
+                        u.extent,
+                        arg.buffer_size.filter(|_| arg.space == AddrSpace::Constant),
+                        dynamic,
+                    ),
+                    &u,
+                ),
                 guest_base: u.escapes || u.cross_compare,
             });
         }
